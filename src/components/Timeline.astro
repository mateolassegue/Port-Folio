---
import people from "../data/people.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="timeline" class="mx-auto max-w-6xl px-4 py-16 reveal">
  <p class="eyebrow">{t(lang, "timeline.eyebrow")}</p>
  <h2 class="mt-1 text-3xl font-bold">{t(lang, "timeline.title")}</h2>
  <div class="mt-8 grid gap-6" data-stagger>
    {people.map((p) => {
      const accent = p.id === "mateo" ? "indigo" : "pink";
      return (
      <div data-person={p.id} class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class={`h-1.5 w-full ${accent === "indigo" ? "bg-indigo-800" : "bg-rose-900"}`} aria-hidden="true"></div>
        <div class="p-6 sm:p-8">
          <h3 class={`text-lg font-semibold ${accent === "indigo" ? "text-indigo-800 dark:text-indigo-300" : "text-rose-900 dark:text-rose-300"}`}>{p.name}</h3>
          <ol class="mt-5 grid gap-x-10 gap-y-8 lg:grid-cols-2">
            {[...p.timeline].reverse().map((e) => (
              <li class={`relative border-l-2 pl-6 ${accent === "indigo" ? "border-indigo-200 dark:border-indigo-900" : "border-rose-200 dark:border-rose-900"}`}>
                <span class={`absolute -left-[7px] top-1.5 h-3 w-3 rounded-full ${accent === "indigo" ? "bg-indigo-800" : "bg-rose-900"}`} aria-hidden="true"></span>
                <p class="text-sm text-slate-500 dark:text-slate-400">{e.period} · {e.place}</p>
                <h4 class="text-lg font-semibold">{tr(e.title, lang)}</h4>
                <p class="mt-1 text-slate-700 dark:text-slate-300">{tr(e.description, lang)}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    )})}
  </div>
</section>
