---
import profile from "../data/profile.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="timeline" class="mx-auto max-w-6xl px-4 py-16 reveal">
  <h2 class="text-3xl font-bold">{t(lang, "timeline.title")}</h2>
  <ol class="mt-6 border-l-2 border-indigo-600 pl-6">
    {profile.timeline.map((e) => (
      <li class="relative mb-8">
        <span class="absolute -left-[33px] top-1.5 h-3 w-3 rounded-full bg-indigo-600" aria-hidden="true"></span>
        <p class="text-sm text-slate-700 dark:text-slate-300">{e.period} · {e.place}</p>
        <h3 class="text-lg font-semibold">{tr(e.title, lang)}</h3>
        <p class="text-slate-700 dark:text-slate-300">{tr(e.description, lang)}</p>
      </li>
    ))}
  </ol>
</section>
