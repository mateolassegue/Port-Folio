---
import people from "../data/people.json";
import { t, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="contact" class="mx-auto max-w-6xl border-t border-slate-200 px-4 py-16 reveal dark:border-slate-800">
  <h2 class="text-3xl font-bold">{t(lang, "contact.title")}</h2>
  <p class="mt-2 max-w-2xl text-slate-700 dark:text-slate-300">{t(lang, "contact.text")}</p>
  <div class="mt-6 grid gap-8 sm:grid-cols-2">
    {people.map((p) => (
      <div data-person={p.id}>
        <h3 class="font-semibold">{p.name}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {p.links.github && <li><a class="rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors hover:bg-indigo-50 hover:text-indigo-700 dark:border-slate-700 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" href={p.links.github} rel="noopener noreferrer">{t(lang, "contact.github")} ↗</a></li>}
          {p.links.linkedin && <li><a class="rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors hover:bg-indigo-50 hover:text-indigo-700 dark:border-slate-700 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" href={p.links.linkedin} rel="noopener noreferrer">{t(lang, "contact.linkedin")} ↗</a></li>}
          {p.links.email && <li><a class="rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors hover:bg-indigo-50 hover:text-indigo-700 dark:border-slate-700 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" href={`mailto:${p.links.email}`}>{t(lang, "contact.email")}</a></li>}
        </ul>
      </div>
    ))}
  </div>
  <p class="mt-12 text-sm text-slate-500 dark:text-slate-400">© {new Date().getFullYear()} {people.map((p) => p.name).join(" & ")}. {t(lang, "footer.rights")}</p>
</section>
