---
import people from "../data/people.json";
import { t, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="contact" class="mx-auto max-w-6xl border-t border-slate-200 px-4 py-16 reveal dark:border-slate-800">
  <p class="eyebrow">{t(lang, "contact.eyebrow")}</p>
  <h2 class="mt-1 text-3xl font-bold">{t(lang, "contact.title")}</h2>
  <p class="mt-2 max-w-2xl text-slate-700 dark:text-slate-300">{t(lang, "contact.text")}</p>
  <div class="mt-8 grid gap-6">
    {people.map((p) => {
      const accent = p.id === "mateo" ? "indigo" : "pink";
      return (
      <div data-person={p.id} class="flex flex-col gap-4 overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:bg-slate-900">
        <h3 class={`font-semibold ${accent === "indigo" ? "text-indigo-800 dark:text-indigo-300" : "text-rose-900 dark:text-rose-300"}`}>{p.name}</h3>
        <ul class="flex flex-wrap gap-2">
          {p.links.github && <li><a class={`rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors dark:border-slate-700 ${accent === "indigo" ? "hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-800 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" : "hover:border-rose-300 hover:bg-rose-50 hover:text-rose-900 dark:hover:bg-rose-900/30 dark:hover:text-rose-300"}`} href={p.links.github} rel="noopener noreferrer">{t(lang, "contact.github")} ↗</a></li>}
          {p.links.linkedin && <li><a class={`rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors dark:border-slate-700 ${accent === "indigo" ? "hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-800 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" : "hover:border-rose-300 hover:bg-rose-50 hover:text-rose-900 dark:hover:bg-rose-900/30 dark:hover:text-rose-300"}`} href={p.links.linkedin} rel="noopener noreferrer">{t(lang, "contact.linkedin")} ↗</a></li>}
          {p.links.email && <li><a class={`rounded-full border border-slate-300 px-3 py-1 text-sm font-medium transition-colors dark:border-slate-700 ${accent === "indigo" ? "hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-800 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-300" : "hover:border-rose-300 hover:bg-rose-50 hover:text-rose-900 dark:hover:bg-rose-900/30 dark:hover:text-rose-300"}`} href={`mailto:${p.links.email}`}>{t(lang, "contact.email")}</a></li>}
        </ul>
      </div>
    )})}
  </div>
  <p class="mt-12 text-sm text-slate-500 dark:text-slate-400">© {new Date().getFullYear()} {people.map((p) => p.name).join(" & ")}. {t(lang, "footer.rights")}</p>
</section>
