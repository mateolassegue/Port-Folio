---
import people from "../data/people.json";
import { t, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-16 reveal">
  <h2 class="text-3xl font-bold">{t(lang, "contact.title")}</h2>
  <p class="mt-2 text-slate-700 dark:text-slate-300">{t(lang, "contact.text")}</p>
  <div class="mt-4 grid gap-8 sm:grid-cols-2">
    {people.map((p) => (
      <div data-person={p.id}>
        <h3 class="font-semibold">{p.name}</h3>
        <ul class="mt-2 flex flex-wrap gap-4">
          {p.links.github && <li><a class="text-indigo-700 underline dark:text-indigo-300" href={p.links.github} rel="noopener noreferrer">{t(lang, "contact.github")}</a></li>}
          {p.links.linkedin && <li><a class="text-indigo-700 underline dark:text-indigo-300" href={p.links.linkedin} rel="noopener noreferrer">{t(lang, "contact.linkedin")}</a></li>}
          {p.links.email && <li><a class="text-indigo-700 underline dark:text-indigo-300" href={`mailto:${p.links.email}`}>{t(lang, "contact.email")}</a></li>}
        </ul>
      </div>
    ))}
  </div>
  <p class="mt-12 text-sm text-slate-700 dark:text-slate-300">© {new Date().getFullYear()} {people.map((p) => p.name).join(" & ")}. {t(lang, "footer.rights")}</p>
</section>
