---
import projects from "../data/projects.json";
import ProjectModal from "./ProjectModal.astro";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const techs = [...new Set((projects as any[]).flatMap((p) => p.stack))].sort();
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 reveal">
  <h2 class="text-3xl font-bold">{t(lang, "projects.title")}</h2>
  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label={t(lang, "projects.filter")}>
    <button type="button" data-filter="all" aria-pressed="true" class="rounded-full border border-slate-400 px-3 py-1 text-sm aria-pressed:bg-indigo-700 aria-pressed:text-white">{t(lang, "projects.all")}</button>
    {techs.map((tech) => (
      <button type="button" data-filter={tech} aria-pressed="false" class="rounded-full border border-slate-400 px-3 py-1 text-sm aria-pressed:bg-indigo-700 aria-pressed:text-white">{tech}</button>
    ))}
  </div>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
    {(projects as any[]).map((p) => (
      <li data-stack={JSON.stringify(p.stack)} class="flex flex-col rounded-lg border border-slate-300 p-5 dark:border-slate-700">
        {p.image && <img src={p.image} alt="" loading="lazy" class="mb-3 rounded" />}
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-xl font-semibold">{tr(p.title, lang)}</h3>
          <span class="rounded bg-slate-200 px-2 py-0.5 text-xs text-slate-900 dark:bg-slate-700 dark:text-slate-100">{t(lang, `projects.status.${p.status}`)}</span>
        </div>
        <p class="mt-2 grow text-slate-700 dark:text-slate-300">{tr(p.description, lang)}</p>
        <ul class="mt-3 flex flex-wrap gap-1 text-xs" aria-label={t(lang, "projects.stack")}>
          {p.stack.map((s: string) => <li class="rounded bg-indigo-100 px-2 py-0.5 text-indigo-900 dark:bg-indigo-900 dark:text-indigo-100">{s}</li>)}
        </ul>
        <button type="button" data-open-project={p.id} class="mt-4 self-start rounded bg-indigo-700 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-800">{t(lang, "projects.details")}</button>
      </li>
    ))}
  </ul>
  <p id="no-projects" hidden class="mt-6">{t(lang, "projects.empty")}</p>
  <ProjectModal lang={lang} />
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>("#project-grid > li");
  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      document.querySelectorAll("[data-filter]").forEach((o) => o.setAttribute("aria-pressed", String(o === btn)));
      let visible = 0;
      items.forEach((li) => {
        const show = f === "all" || (JSON.parse(li.dataset.stack!) as string[]).includes(f);
        li.hidden = !show;
        if (show) visible++;
      });
      document.getElementById("no-projects")!.hidden = visible > 0;
    }),
  );
</script>
