---
import projects from "../data/projects.json";
import people from "../data/people.json";
import { t, tr, url, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const techs = [...new Set((projects as any[]).flatMap((p) => p.stack))].sort();
const nameOf = (id: string) => people.find((p) => p.id === id)?.name.split(" ")[0] ?? id;
const initialsOf = (title: string) =>
  title.split(/[\s—-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 reveal">
  <p class="eyebrow">{t(lang, "projects.eyebrow")}</p>
  <h2 class="mt-1 text-3xl font-bold">{t(lang, "projects.title")}</h2>
  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label={t(lang, "projects.filter")}>
    <button type="button" data-filter="all" aria-pressed="true" class="rounded-full border border-slate-300 px-3 py-1 text-sm transition-colors hover:bg-slate-100 aria-pressed:border-[var(--accent)] aria-pressed:bg-[var(--accent)] aria-pressed:text-white dark:border-slate-700 dark:hover:bg-slate-800">{t(lang, "projects.all")}</button>
    {techs.map((tech) => (
      <button type="button" data-filter={tech} aria-pressed="false" class="rounded-full border border-slate-300 px-3 py-1 text-sm transition-colors hover:bg-slate-100 aria-pressed:border-[var(--accent)] aria-pressed:bg-[var(--accent)] aria-pressed:text-white dark:border-slate-700 dark:hover:bg-slate-800">{tech}</button>
    ))}
  </div>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
    {(projects as any[]).map((p) => {
      const barClass = p.authors.length > 1 ? "bg-gradient-to-r from-indigo-600 to-pink-500" : p.authors[0] === "rhizlene" ? "bg-pink-500" : "bg-indigo-600";
      return (
      <li data-stack={JSON.stringify(p.stack)} data-authors={p.authors.join(" ")} class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
        <div class={`h-1 w-full ${barClass}`} aria-hidden="true"></div>
        <div class="flex flex-col p-5">
        {p.image ? (
          <div class="relative mb-3 aspect-[4/3] overflow-hidden rounded-lg">
            <img src={url(p.image)} aria-hidden="true" class="absolute inset-0 h-full w-full scale-125 object-cover opacity-50 blur-xl" />
            <img src={url(p.image)} alt="" loading="lazy" class="relative h-full w-full object-contain transition-transform duration-300 group-hover:scale-105" />
          </div>
        ) : (
          <div class="bg-grid-pattern mb-3 flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg bg-gradient-to-br from-indigo-600 to-indigo-900">
            <span class="text-4xl font-bold text-white/90">{initialsOf(tr(p.title, lang))}</span>
          </div>
        )}
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-xl font-semibold">{tr(p.title, lang)}</h3>
          <span class="shrink-0 rounded bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-900 dark:bg-slate-700 dark:text-slate-100">{t(lang, `projects.status.${p.status}`)}</span>
        </div>
        <p class="mt-1 text-xs font-semibold text-[var(--accent)]">{p.authors.map(nameOf).join(" & ")}</p>
        <p class="mt-2 grow text-slate-700 dark:text-slate-300">{tr(p.description, lang)}</p>
        <ul class="mt-3 flex flex-wrap gap-1 text-xs" aria-label={t(lang, "projects.stack")}>
          {p.stack.map((s: string) => <li class="rounded bg-indigo-100 px-2 py-0.5 text-indigo-900 dark:bg-indigo-900 dark:text-indigo-100">{s}</li>)}
        </ul>
        <a href={url(`${lang}/projects/${p.id}/`)} class="mt-4 self-start rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[var(--accent-dark)] hover:shadow-md">{t(lang, "projects.details")}</a>
        </div>
      </li>
    )})}
  </ul>
  <p id="no-projects" hidden class="mt-6">{t(lang, "projects.empty")}</p>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>("#project-grid > li");

  function updateEmptyState() {
    let visible = 0;
    items.forEach((li) => {
      if (!li.hidden && getComputedStyle(li).display !== "none") visible++;
    });
    document.getElementById("no-projects")!.hidden = visible > 0;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      document.querySelectorAll("[data-filter]").forEach((o) => o.setAttribute("aria-pressed", String(o === btn)));
      items.forEach((li) => {
        const show = f === "all" || (JSON.parse(li.dataset.stack!) as string[]).includes(f);
        li.hidden = !show;
      });
      updateEmptyState();
    }),
  );
  document.addEventListener("person:change", updateEmptyState);
  updateEmptyState();
</script>
