---
import projects from "../data/projects.json";
import people from "../data/people.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };

// Skill score = share of a person's projects using each technology (ties to the Mateo/Rhizlène filter).
// When a project documents which stack items each person actually worked on (stackByPerson), use that
// subset instead of the full stack so the per-person chart reflects real, documented contributions.
function computeFor(personId: string | "all") {
  const scoped = (projects as any[]).filter((p) => personId === "all" || p.authors.includes(personId));
  const totals: Record<string, number> = {};
  for (const p of scoped) {
    const stackForPerson = personId !== "all" && p.stackByPerson?.[personId] ? p.stackByPerson[personId] : p.stack;
    const share = 100 / p.stack.length;
    for (const tech of stackForPerson) totals[tech] = (totals[tech] ?? 0) + share;
  }
  const n = scoped.length || 1;
  return Object.entries(totals)
    .map(([label, sum]) => ({ label, value: Math.round((sum / n) * 10) / 10 }))
    .sort((a, b) => b.value - a.value);
}

const chartByPerson: Record<string, { label: string; value: number }[]> = {
  all: computeFor("all"),
  ...Object.fromEntries((people as any[]).map((p) => [p.id, computeFor(p.id)])),
};
---

<section id="skills" class="reveal bg-slate-50 py-16 dark:bg-slate-900/40">
  <div class="mx-auto max-w-6xl px-4">
  <h2 class="text-3xl font-bold">{t(lang, "skills.title")}</h2>
  <p class="mt-2 text-slate-700 dark:text-slate-300">{t(lang, "skills.intro")}</p>
  <div class="mt-4 flex gap-2" role="group" aria-label={t(lang, "skills.chartAria")}>
    <button type="button" data-chart-type="bar" aria-pressed="true" class="rounded border border-slate-300 px-3 py-1 text-sm transition-colors hover:bg-slate-100 aria-pressed:border-indigo-700 aria-pressed:bg-indigo-700 aria-pressed:text-white dark:border-slate-700 dark:hover:bg-slate-800">{t(lang, "skills.toggleBar")}</button>
    <button type="button" data-chart-type="radar" aria-pressed="false" class="rounded border border-slate-300 px-3 py-1 text-sm transition-colors hover:bg-slate-100 aria-pressed:border-indigo-700 aria-pressed:bg-indigo-700 aria-pressed:text-white dark:border-slate-700 dark:hover:bg-slate-800">{t(lang, "skills.toggleRadar")}</button>
  </div>
  <div class="relative mt-4 h-80 max-w-3xl rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <canvas id="skills-chart" role="img" aria-label={t(lang, "skills.chartAria")} data-skills={JSON.stringify(chartByPerson)} data-label={t(lang, "skills.chartLabel")} data-people={JSON.stringify(Object.fromEntries((people as any[]).map((p) => [p.id, p.name.split(" ")[0]])))}></canvas>
  </div>
  <ul class="sr-only" id="skills-sr"></ul>

  <h3 class="mt-10 text-xl font-semibold">{t(lang, "skills.core")}</h3>
  <div class="mt-4 grid gap-6 sm:grid-cols-2">
    {(people as any[]).map((p) => (
      <div data-person={p.id} class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm font-semibold text-indigo-700 dark:text-indigo-300">{p.name}</p>
        <div class="mt-2 space-y-3">
          {p.skills.map((group: any) => (
            <div>
              <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">{tr(group.category, lang)}</p>
              <ul class="mt-1 flex flex-wrap gap-1 text-xs">
                {group.items.map((item: string) => <li class="rounded bg-indigo-100 px-2 py-0.5 text-indigo-900 dark:bg-indigo-900 dark:text-indigo-100">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  </div>
</section>

<script>
  import { Chart, registerables } from "chart.js";
  Chart.register(...registerables);
  const canvas = document.getElementById("skills-chart") as HTMLCanvasElement;
  const byPerson: Record<string, { label: string; value: number }[]> = JSON.parse(canvas.dataset.skills!);
  const peopleNames: Record<string, string> = JSON.parse(canvas.dataset.people!);
  const personColors: Record<string, string> = { mateo: "#6366f1", rhizlene: "#ec4899" };
  const srList = document.getElementById("skills-sr")!;
  let chart: Chart | null = null;

  function currentPerson() {
    return document.documentElement.dataset.person || "all";
  }

  function render(type: "bar" | "radar") {
    chart?.destroy();
    const dark = document.documentElement.classList.contains("dark");
    const color = dark ? "#e2e8f0" : "#0f172a";
    const grid = dark ? "#334155" : "#cbd5e1";
    const person = currentPerson();

    let labels: string[];
    let datasets: { label: string; data: number[]; backgroundColor: string | string[]; borderColor: string | string[]; borderWidth: number }[];

    if (person === "all") {
      const peopleIds = Object.keys(peopleNames);
      const byLabel = new Map<string, Record<string, number>>();
      for (const id of peopleIds) {
        for (const s of byPerson[id] ?? []) {
          if (!byLabel.has(s.label)) byLabel.set(s.label, {});
          byLabel.get(s.label)![id] = s.value;
        }
      }
      labels = [...byLabel.keys()].sort((a, b) => {
        const sum = (l: string) => peopleIds.reduce((acc, id) => acc + (byLabel.get(l)?.[id] ?? 0), 0);
        return sum(b) - sum(a);
      });
      datasets = peopleIds.map((id) => {
        const c = personColors[id] ?? "#6366f1";
        return {
          label: peopleNames[id],
          data: labels.map((l) => byLabel.get(l)?.[id] ?? 0),
          backgroundColor: `${c}80`,
          borderColor: c,
          borderWidth: 2,
        };
      });
    } else {
      const skills = byPerson[person] ?? [];
      labels = skills.map((s) => s.label);
      const c = personColors[person] ?? "#6366f1";
      datasets = [{ label: peopleNames[person] ?? canvas.dataset.label!, data: skills.map((s) => s.value), backgroundColor: `${c}80`, borderColor: c, borderWidth: 2 }];
    }

    srList.replaceChildren(...datasets.flatMap((d) =>
      d.data.map((v, i) => {
        const li = document.createElement("li");
        li.textContent = `${d.label} — ${labels[i]}: ${v}%`;
        return li;
      }),
    ));

    chart = new Chart(canvas, {
      type,
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: type === "bar" ? "y" : undefined,
        plugins: { legend: { labels: { color } } },
        scales: type === "bar"
          ? { x: { min: 0, max: 100, ticks: { color }, grid: { color: grid } }, y: { ticks: { color }, grid: { color: grid } } }
          : { r: { min: 0, max: 100, ticks: { color, backdropColor: "transparent" }, grid: { color: grid }, angleLines: { color: grid }, pointLabels: { color } } },
      },
    });
  }
  let current: "bar" | "radar" = "bar";
  render(current);
  document.querySelectorAll<HTMLButtonElement>("[data-chart-type]").forEach((b) =>
    b.addEventListener("click", () => {
      current = b.dataset.chartType as "bar" | "radar";
      document.querySelectorAll("[data-chart-type]").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      render(current);
    }),
  );
  document.addEventListener("person:change", () => render(current));
  new MutationObserver(() => render(current)).observe(document.documentElement, { attributeFilter: ["class"] });
</script>
