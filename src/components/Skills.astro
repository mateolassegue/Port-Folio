---
import people from "../data/people.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };

// Competency profile: a hand-curated 0-5 mastery score per broad category (not a project-usage
// percentage), designed to visually contrast each person's complementary strengths at a glance.
const QUALITY_AXES = ["cad", "embedded", "programming", "ai", "tools", "management"] as const;
const qualityLabels = Object.fromEntries(QUALITY_AXES.map((a) => [a, t(lang, `skills.axis${a[0].toUpperCase()}${a.slice(1)}`)]));
const qualitiesByPerson = Object.fromEntries((people as any[]).map((p) => [p.id, QUALITY_AXES.map((a) => p.qualities?.[a] ?? 0)]));
---

<section id="skills" class="reveal bg-slate-50 py-16 dark:bg-slate-900/40">
  <div class="mx-auto max-w-6xl px-4">
  <h2 class="text-3xl font-bold">{t(lang, "skills.title")}</h2>
  <p class="mt-2 max-w-3xl text-slate-700 dark:text-slate-300">{t(lang, "skills.intro")}</p>

  <h3 class="sr-only">{t(lang, "skills.core")}</h3>
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {(people as any[]).map((p) => {
      const accent = p.id === "mateo" ? "indigo" : "pink";
      return (
      <div data-person={p.id} class={`group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900`}>
        <div class={`h-1.5 w-full ${accent === "indigo" ? "bg-indigo-600" : "bg-pink-500"}`} aria-hidden="true"></div>
        <div class="p-6">
          <div class="flex items-center gap-4">
            <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white ${accent === "indigo" ? "bg-indigo-700" : "bg-pink-600"}`} aria-hidden="true">
              {p.name.split(" ").map((w: string) => w[0]).join("").slice(0, 2)}
            </div>
            <div>
              <p class="text-lg font-bold">{p.name}</p>
              <p class={`text-sm font-medium ${accent === "indigo" ? "text-indigo-700 dark:text-indigo-300" : "text-pink-700 dark:text-pink-300"}`}>{tr(p.title, lang)}</p>
            </div>
          </div>

          {p.highlights && p.highlights.length > 0 && (
            <ul class="mt-5 space-y-2">
              {p.highlights.map((h: any) => (
                <li class="flex gap-2 text-sm text-slate-700 dark:text-slate-300">
                  <svg class={`mt-0.5 h-4 w-4 shrink-0 ${accent === "indigo" ? "text-indigo-600" : "text-pink-500"}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"></path></svg>
                  <span>{tr(h, lang)}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-5 space-y-3 border-t border-slate-100 pt-4 dark:border-slate-800">
            {p.skills.map((group: any) => (
              <div>
                <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">{tr(group.category, lang)}</p>
                <ul class="mt-1.5 flex flex-wrap gap-1.5 text-xs">
                  {group.items.map((item: string) => (
                    <li class={`rounded-full px-2.5 py-1 font-medium ${accent === "indigo" ? "bg-indigo-100 text-indigo-900 dark:bg-indigo-900/60 dark:text-indigo-100" : "bg-pink-100 text-pink-900 dark:bg-pink-900/50 dark:text-pink-100"}`}>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    )})}
  </div>

  <div class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h3 class="text-xl font-semibold">{t(lang, "skills.profileTitle")}</h3>
    <p class="mt-1 max-w-2xl text-sm text-slate-600 dark:text-slate-400">{t(lang, "skills.profileIntro")}</p>
    <div class="relative mt-4 w-full max-w-3xl">
      <canvas
        id="skills-quality-chart"
        role="img"
        aria-label={t(lang, "skills.profileAria")}
        data-qualities={JSON.stringify(qualitiesByPerson)}
        data-axes={JSON.stringify(qualityLabels)}
        data-level-label={t(lang, "skills.level")}
        data-people={JSON.stringify(Object.fromEntries((people as any[]).map((p) => [p.id, p.name.split(" ")[0]])))}
      ></canvas>
    </div>
    <ul class="sr-only" id="skills-quality-sr"></ul>
  </div>
  </div>
</section>

<script>
  // Competency profile: a 0-5 radar comparing both people across broad, hand-curated category axes
  // (complementary to the raw technology-usage chart above, which only measures project frequency).
  import { Chart, registerables } from "chart.js";
  Chart.register(...registerables);
  const qCanvas = document.getElementById("skills-quality-chart") as HTMLCanvasElement;
  const qContainer = qCanvas.parentElement as HTMLElement;
  qContainer.style.height = "26rem";
  const qualitiesByPerson: Record<string, number[]> = JSON.parse(qCanvas.dataset.qualities!);
  const axisLabels: Record<string, string> = JSON.parse(qCanvas.dataset.axes!);
  const qPeopleNames: Record<string, string> = JSON.parse(qCanvas.dataset.people!);
  const levelLabel = qCanvas.dataset.levelLabel!;
  const qPersonColors: Record<string, string> = { mateo: "#6366f1", rhizlene: "#ec4899" };
  const qSrList = document.getElementById("skills-quality-sr")!;
  let qChart: Chart | null = null;

  function qCurrentPerson() {
    return document.documentElement.dataset.person || "all";
  }

  function renderQuality() {
    qChart?.destroy();
    const dark = document.documentElement.classList.contains("dark");
    const color = dark ? "#e2e8f0" : "#0f172a";
    const grid = dark ? "#334155" : "#e2e8f0";
    const person = qCurrentPerson();
    const ids = person === "all" ? Object.keys(qPeopleNames) : [person];
    const labels = Object.values(axisLabels);

    const datasets = ids.map((id) => {
      const c = qPersonColors[id] ?? "#6366f1";
      return {
        label: qPeopleNames[id] ?? id,
        data: qualitiesByPerson[id] ?? labels.map(() => 0),
        backgroundColor: `${c}33`,
        borderColor: c,
        borderWidth: 2,
        pointBackgroundColor: c,
        pointRadius: 3,
      };
    });

    qSrList.replaceChildren(...datasets.flatMap((d) =>
      d.data.map((v, i) => {
        const li = document.createElement("li");
        li.textContent = `${d.label} — ${labels[i]}: ${levelLabel} ${v}/5`;
        return li;
      }),
    ));

    qChart = new Chart(qCanvas, {
      type: "radar",
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: datasets.length > 1, labels: { color, usePointStyle: true, boxWidth: 8 } },
          tooltip: { callbacks: { label: (ctx) => ` ${ctx.dataset.label}: ${levelLabel} ${ctx.parsed.r}/5` } },
        },
        scales: {
          r: { min: 0, max: 5, ticks: { color, backdropColor: "transparent", stepSize: 1 }, grid: { color: grid }, angleLines: { color: grid }, pointLabels: { color, font: { size: 12, weight: 600 } } },
        },
      },
    });
  }
  renderQuality();
  document.addEventListener("person:change", renderQuality);
  new MutationObserver(renderQuality).observe(document.documentElement, { attributeFilter: ["class"] });
</script>
