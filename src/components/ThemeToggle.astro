---
import { t, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<button type="button" id="theme-toggle" aria-label={t(lang, "theme.toggle")} class="rounded border border-slate-400 px-2 py-1 text-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:hover:bg-slate-800">
  <span class="dark:hidden" aria-hidden="true">🌙</span>
  <span class="hidden dark:inline" aria-hidden="true">☀️</span>
</button>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
