---
import people from "../data/people.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const initials = (name: string) => name.split(" ").map((w) => w[0]).join("").slice(0, 2);
---

<section id="home" class="reveal bg-gradient-to-b from-indigo-50 via-white to-white py-20 dark:from-slate-900 dark:via-slate-950 dark:to-slate-950">
  <div class="mx-auto max-w-6xl px-4">
    <p class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800 dark:border-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-200">
      🇬🇧 {t(lang, "hero.badge")}
    </p>
    <p class="mt-4 text-indigo-700 dark:text-indigo-300">{t(lang, "hero.greeting")}</p>
    <div class="mt-2 grid gap-6 sm:grid-cols-2">
      {people.map((p) => (
        <div data-person={p.id} class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-4">
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-indigo-700 text-xl font-bold text-white">{initials(p.name)}</span>
            <h1 class="text-2xl font-bold sm:text-3xl">{p.name}</h1>
          </div>
          <p class="mt-3 text-lg text-slate-700 dark:text-slate-300">{tr(p.title, lang)}</p>
          <p class="mt-3 max-w-xl text-slate-700 dark:text-slate-300">{tr(p.bio, lang)}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#projects" class="rounded-lg bg-indigo-700 px-5 py-2 font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-indigo-800 hover:shadow-md">{t(lang, "hero.cta")}</a>
            <a href="#contact" class="rounded-lg border border-slate-300 px-5 py-2 font-semibold transition-colors hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">{t(lang, "hero.contact")}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
