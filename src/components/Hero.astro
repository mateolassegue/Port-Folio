---
import profile from "../data/profile.json";
import { t, tr, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
---

<section id="home" class="mx-auto max-w-6xl px-4 py-20 reveal">
  <p class="text-indigo-700 dark:text-indigo-300">{t(lang, "hero.greeting")}</p>
  <h1 class="mt-2 text-4xl font-bold sm:text-6xl">{profile.name}</h1>
  <p class="mt-4 text-xl text-slate-700 dark:text-slate-300">{tr(profile.title, lang)}</p>
  <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">{tr(profile.bio, lang)}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#projects" class="rounded bg-indigo-700 px-5 py-2 font-semibold text-white hover:bg-indigo-800">{t(lang, "hero.cta")}</a>
    <a href="#contact" class="rounded border border-slate-400 px-5 py-2 font-semibold hover:bg-slate-100 dark:hover:bg-slate-800">{t(lang, "hero.contact")}</a>
  </div>
</section>
