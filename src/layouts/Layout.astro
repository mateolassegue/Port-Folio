---
import "../styles/global.css";
import Header from "../components/Header.astro";
import people from "../data/people.json";
import { t, type Lang } from "../i18n/utils";
interface Props { lang: Lang }
const { lang } = Astro.props;
const personIds = (people as any[]).map((p) => p.id);
const personNames = Object.fromEntries((people as any[]).map((p) => [p.id, p.name.split(" ")[0]]));
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(lang, "meta.title")}</title>
    <meta name="description" content={t(lang, "meta.description")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@600;700;800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ personIds, personNames }}>
      (function () {
        var s = localStorage.getItem("theme");
        var dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        // Allow deep-linking a CV straight to one person's filtered view, e.g. ?person=mateo#projects.
        var urlPerson = new URLSearchParams(location.search).get("person");
        var validUrlPerson = urlPerson === "all" || personIds.indexOf(urlPerson) !== -1;
        var person = validUrlPerson ? urlPerson : localStorage.getItem("person") || "all";
        document.documentElement.dataset.person = person;
        if (validUrlPerson) localStorage.setItem("person", person);
        // Remember the page's default title so the switcher can restore it when back on "all".
        window.__baseTitle = document.title;
        window.__personNames = personNames;
        if (person !== "all") document.title = "Port-Folio " + (personNames[person] || "");
      })();
    </script>
  </head>
  <body class="bg-grid-pattern bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-indigo-700 focus:px-3 focus:py-2 focus:text-white">{t(lang, "skip")}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          if (el.hasAttribute("data-stagger")) {
            Array.from(el.children).forEach((child, i) => {
              (child as HTMLElement).style.transitionDelay = `${i * 80}ms`;
            });
          }
          el.classList.add("visible");
          io.unobserve(el);
        });
      }, { threshold: 0.1 });
      document.querySelectorAll(".reveal, [data-stagger]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
